<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CraveHub — Fast Food</title>

<style>
:root{
  --primary:#e63946;
  --dark:#111;
  --cream:#fff8ef;
  --white:#fff;
  --text:#222;
  --muted:#777;
  --shadow:0 10px 30px rgba(0,0,0,.10);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--cream);
  color:var(--text);
}

a{
  color:inherit;
  text-decoration:none;
}

button{
  border:0;
  cursor:pointer;
}

/* NAVBAR */
.navbar{
  position:sticky;
  top:0;
  z-index:1000;
  background:#fff;
  box-shadow:0 2px 15px rgba(0,0,0,.08);
}

.nav-inner{
  max-width:1200px;
  margin:auto;
  padding:15px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  font-size:26px;
  font-weight:900;
  color:var(--primary);
}

.logo span{
  color:#111;
}

.nav-links{
  display:flex;
  gap:25px;
  font-weight:bold;
}

.nav-links a:hover{
  color:var(--primary);
}

.nav-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

.order-btn,
.cart-btn{
  padding:12px 18px;
  border-radius:30px;
  font-weight:bold;
}

.order-btn{
  background:var(--primary);
  color:#fff;
}

.cart-btn{
  background:#111;
  color:#fff;
}

.menu-toggle{
  display:none;
  font-size:25px;
  background:none;
}

/* HERO */
.hero{
  max-width:1200px;
  margin:auto;
  padding:70px 20px;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:50px;
}

.hero h1{
  font-size:clamp(42px,6vw,76px);
  line-height:.95;
  margin-bottom:25px;
}

.hero h1 span{
  color:var(--primary);
}

.hero p{
  color:var(--muted);
  font-size:18px;
  line-height:1.7;
  margin-bottom:30px;
}

.hero-buttons{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
}

.primary-btn,
.secondary-btn{
  padding:15px 25px;
  border-radius:30px;
  font-weight:bold;
}

.primary-btn{
  background:var(--primary);
  color:#fff;
}

.secondary-btn{
  background:#111;
  color:#fff;
}

.hero-image{
  min-height:420px;
  border-radius:35px;
  background:
    linear-gradient(rgba(0,0,0,.15),rgba(0,0,0,.15)),
    url("https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1000&q=80")
    center/cover;
  box-shadow:var(--shadow);
}

/* PROMO */
.promo{
  background:#111;
  color:#fff;
  padding:35px 20px;
}

.promo-inner{
  max-width:1200px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.promo h2{
  font-size:32px;
}

.promo p{
  color:#ccc;
  margin-top:8px;
}

.promo button{
  background:var(--primary);
  color:#fff;
  padding:14px 24px;
  border-radius:30px;
  font-weight:bold;
}

/* SECTIONS */
.section{
  max-width:1200px;
  margin:auto;
  padding:75px 20px;
}

.section-title{
  text-align:center;
  margin-bottom:35px;
}

.section-title h2{
  font-size:40px;
}

.section-title p{
  color:var(--muted);
  margin-top:8px;
}

/* CATEGORY */
.categories{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:35px;
}

.category{
  background:#fff;
  border:1px solid #eee;
  padding:11px 20px;
  border-radius:30px;
  font-weight:bold;
}

.category.active,
.category:hover{
  background:var(--primary);
  color:#fff;
}

/* SEARCH */
.search-box{
  max-width:500px;
  margin:0 auto 30px;
}

.search-box input{
  width:100%;
  padding:16px 20px;
  border-radius:30px;
  border:1px solid #ddd;
  outline:none;
  font-size:16px;
}

/* PRODUCTS */
.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:20px;
}

.card{
  background:#fff;
  border-radius:20px;
  overflow:hidden;
  box-shadow:var(--shadow);
  transition:.25s;
}

.card:hover{
  transform:translateY(-6px);
}

.card-img{
  height:210px;
  background-size:cover;
  background-position:center;
}

.card-body{
  padding:18px;
}

.card-body h3{
  margin-bottom:8px;
}

.card-body p{
  color:var(--muted);
  font-size:14px;
  line-height:1.5;
  min-height:42px;
}

.price-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:18px;
}

.price{
  font-weight:900;
  font-size:18px;
}

.add-btn{
  background:var(--primary);
  color:#fff;
  width:42px;
  height:42px;
  border-radius:50%;
  font-size:22px;
}

/* FEATURES */
.features{
  background:#fff;
}

.feature-grid{
  max-width:1200px;
  margin:auto;
  padding:65px 20px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:25px;
}

.feature{
  text-align:center;
  padding:30px;
}

.feature-icon{
  font-size:45px;
  margin-bottom:15px;
}

.feature h3{
  margin-bottom:10px;
}

.feature p{
  color:var(--muted);
  line-height:1.6;
}

/* LOCATION */
.location{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:30px;
  align-items:center;
}

.location-box{
  background:#111;
  color:#fff;
  border-radius:25px;
  padding:35px;
}

.location-box h2{
  font-size:38px;
  margin-bottom:15px;
}

.location-box p{
  color:#ccc;
  line-height:1.8;
}

.map{
  min-height:330px;
  border-radius:25px;
  background:
    linear-gradient(rgba(0,0,0,.2),rgba(0,0,0,.2)),
    url("https://images.unsplash.com/photo-1524666041070-9e8b3e4a7c6a?auto=format&fit=crop&w=1000&q=80")
    center/cover;
}

/* FOOTER */
footer{
  background:#111;
  color:#fff;
  padding:50px 20px;
}

.footer-inner{
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:40px;
}

footer h3{
  margin-bottom:15px;
}

footer p,
footer a{
  color:#aaa;
  line-height:2;
}

footer a:hover{
  color:#fff;
}

.copyright{
  max-width:1200px;
  margin:35px auto 0;
  padding-top:25px;
  border-top:1px solid #333;
  color:#777;
}

/* CART */
.cart-overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  z-index:2000;
  display:none;
}

.cart-overlay.show{
  display:block;
}

.cart{
  position:absolute;
  right:0;
  top:0;
  width:min(430px,100%);
  height:100%;
  background:#fff;
  padding:25px;
  overflow:auto;
}

.cart-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:25px;
}

.close-cart{
  background:#eee;
  width:38px;
  height:38px;
  border-radius:50%;
  font-size:20px;
}

.cart-item{
  display:flex;
  justify-content:space-between;
  gap:15px;
  padding:15px 0;
  border-bottom:1px solid #eee;
}

.cart-item small{
  color:var(--muted);
}

.remove{
  background:none;
  color:var(--primary);
}

.cart-total{
  display:flex;
  justify-content:space-between;
  font-size:22px;
  font-weight:bold;
  margin:25px 0;
}

.checkout{
  width:100%;
  background:var(--primary);
  color:#fff;
  padding:16px;
  border-radius:30px;
  font-weight:bold;
}

/* RESPONSIVE */
@media(max-width:900px){
  .products{
    grid-template-columns:repeat(2,1fr);
  }

  .hero{
    grid-template-columns:1fr;
  }

  .location{
    grid-template-columns:1fr;
  }

  .feature-grid{
    grid-template-columns:1fr;
  }

  .footer-inner{
    grid-template-columns:1fr;
  }
}

@media(max-width:700px){
  .nav-links{
    display:none;
    position:absolute;
    top:65px;
    left:0;
    right:0;
    background:#fff;
    padding:20px;
    flex-direction:column;
    box-shadow:0 10px 20px rgba(0,0,0,.1);
  }

  .nav-links.show{
    display:flex;
  }

  .menu-toggle{
    display:block;
  }

  .order-btn{
    display:none;
  }

  .products{
    grid-template-columns:1fr;
  }

  .hero{
    padding-top:40px;
  }

  .hero-image{
    min-height:300px;
  }

  .promo-inner{
    flex-direction:column;
    align-items:flex-start;
  }
}
</style>
</head>

<body>

<!-- NAVIGATION -->
<header class="navbar">
  <div class="nav-inner">

    <a href="#" class="logo">
      CRAVE<span>HUB</span>
    </a>

    <nav class="nav-links" id="navLinks">
      <a href="#home">Home</a>
      <a href="#menu">Menu</a>
      <a href="#offers">Offers</a>
      <a href="#locations">Locations</a>
      <a href="#contact">Contact</a>
    </nav>

    <div class="nav-actions">
      <button class="order-btn" onclick="scrollToMenu()">Order Now</button>
      <button class="cart-btn" onclick="openCart()">🛒 <span id="cartCount">0</span></button>
      <button class="menu-toggle" onclick="toggleMenu()">☰</button>
    </div>

  </div>
</header>

<!-- HERO -->
<main id="home">

<section class="hero">

  <div>
    <h1>
      GOOD FOOD.<br>
      <span>GOOD MOOD.</span>
    </h1>

    <p>
      Fresh burgers, crispy chicken, golden fries and refreshing drinks —
      made for every craving.
    </p>

    <div class="hero-buttons">
      <button class="primary-btn" onclick="scrollToMenu()">View Menu</button>
      <button class="secondary-btn" onclick="openCart()">View Cart</button>
    </div>
  </div>

  <div class="hero-image"></div>

</section>

<!-- PROMOTION -->
<section class="promo" id="offers">
  <div class="promo-inner">
    <div>
      <h2>🔥 Weekend Special</h2>
      <p>Get a Burger + Fries + Drink combo today.</p>
    </div>

    <button onclick="scrollToMenu()">Order Now</button>
  </div>
</section>

<!-- MENU -->
<section class="section" id="menu">

  <div class="section-title">
    <h2>Our Menu</h2>
    <p>Pick your favourite.</p>
  </div>

  <div class="search-box">
    <input
      type="text"
      id="searchInput"
      placeholder="Search burgers, chicken, fries..."
      oninput="renderProducts()"
    >
  </div>

  <div class="categories">
    <button class="category active" onclick="setCategory('All',this)">All</button>
    <button class="category" onclick="setCategory('Burgers',this)">Burgers</button>
    <button class="category" onclick="setCategory('Chicken',this)">Chicken</button>
    <button class="category" onclick="setCategory('Fries',this)">Fries</button>
    <button class="category" onclick="setCategory('Drinks',this)">Drinks</button>
    <button class="category" onclick="setCategory('Combos',this)">Combos</button>
  </div>

  <div class="products" id="products"></div>

</section>

<!-- FEATURES -->
<section class="features">

  <div class="feature-grid">

    <div class="feature">
      <div class="feature-icon">🍔</div>
      <h3>Fresh Food</h3>
      <p>Prepared fresh and served with quality ingredients.</p>
    </div>

    <div class="feature">
      <div class="feature-icon">⚡</div>
      <h3>Fast Service</h3>
      <p>Get your favourite meals without unnecessary waiting.</p>
    </div>

    <div class="feature">
      <div class="feature-icon">🚗</div>
      <h3>Easy Ordering</h3>
      <p>Order online and contact us for delivery options.</p>
    </div>

  </div>

</section>

<!-- LOCATION -->
<section class="section" id="locations">

  <div class="location">

    <div class="location-box">
      <h2>Find Us</h2>

      <p>
        📍 123 Food Street<br>
        Benin City, Edo State, Nigeria
      </p>

      <br>

      <p>
        🕐 Monday – Sunday<br>
        9:00 AM – 10:00 PM
      </p>

      <br>

      <button class="primary-btn" onclick="openWhatsApp()">
        Contact Us
      </button>
    </div>

    <div class="map"></div>

  </div>

</section>

</main>

<!-- FOOTER -->
<footer id="contact">

  <div class="footer-inner">

    <div>
      <div class="logo">CRAVE<span style="color:white">HUB</span></div>

      <p>
        Delicious food. Great prices. Good vibes.
      </p>
    </div>

    <div>
      <h3>Quick Links</h3>
      <p><a href="#home">Home</a></p>
      <p><a href="#menu">Menu</a></p>
      <p><a href="#offers">Offers</a></p>
      <p><a href="#locations">Locations</a></p>
    </div>

    <div>
      <h3>Contact</h3>
      <p>📱 +234 800 000 0000</p>
      <p>📧 hello@cravehub.com</p>
      <p>📍 Benin City, Nigeria</p>
    </div>

  </div>

  <div class="copyright">
    © 2026 CraveHub. All rights reserved.
  </div>

</footer>

<!-- CART -->
<div class="cart-overlay" id="cartOverlay">

  <div class="cart">

    <div class="cart-header">
      <h2>Your Order</h2>
      <button class="close-cart" onclick="closeCart()">×</button>
    </div>

    <div id="cartItems"></div>

    <div class="cart-total">
      <span>Total</span>
      <span>₦<span id="cartTotal">0</span></span>
    </div>

    <button class="checkout" onclick="checkout()">
      Order on WhatsApp
    </button>

  </div>

</div>

<script>

const products = [

  {
    id:1,
    name:"Classic Burger",
    category:"Burgers",
    price:4500,
    image:"https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80",
    description:"Juicy beef burger with fresh vegetables."
  },

  {
    id:2,
    name:"Double Cheeseburger",
    category:"Burgers",
    price:6500,
    image:"https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=800&q=80",
    description:"Two beef patties with melted cheese."
  },

  {
    id:3,
    name:"Crispy Chicken",
    category:"Chicken",
    price:5000,
    image:"https://images.unsplash.com/photo-1562967916-eb82221dfb36?auto=format&fit=crop&w=800&q=80",
    description:"Crunchy golden chicken with a delicious coating."
  },

  {
    id:4,
    name:"Chicken Wings",
    category:"Chicken",
    price:5500,
    image:"https://images.unsplash.com/photo-1527477396000-e27163b481c2?auto=format&fit=crop&w=800&q=80",
    description:"Crispy wings served with your favourite sauce."
  },

  {
    id:5,
    name:"Golden Fries",
    category:"Fries",
    price:2500,
    image:"https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=800&q=80",
    description:"Crispy golden fries, lightly salted."
  },

  {
    id:6,
    name:"Loaded Fries",
    category:"Fries",
    price:4000,
    image:"https://images.unsplash.com/photo-1585109649139-366815a0d713?auto=format&fit=crop&w=800&q=80",
    description:"Fries loaded with tasty toppings."
  },

  {
    id:7,
    name:"Cold Cola",
    category:"Drinks",
    price:1500,
    image:"https://images.unsplash.com/photo-1629203849820-fdd70d49c38e?auto=format&fit=crop&w=800&q=80",
    description:"Ice-cold refreshing cola."
  },

  {
    id:8,
    name:"Fresh Lemonade",
    category:"Drinks",
    price:2000,
    image:"https://images.unsplash.com/photo-1621263764928-df1444c5e859?auto=format&fit=crop&w=800&q=80",
    description:"Refreshing freshly prepared lemonade."
  },

  {
    id:9,
    name:"Burger Combo",
    category:"Combos",
    price:7500,
    image:"https://images.unsplash.com/photo-1551782450-a2132b4ba21d?auto=format&fit=crop&w=800&q=80",
    description:"Burger, fries and a refreshing drink."
  },

  {
    id:10,
    name:"Chicken Combo",
    category:"Combos",
    price:8500,
    image:"https://images.unsplash.com/photo-1562967916-eb82221dfb36?auto=format&fit=crop&w=800&q=80",
    description:"Crispy chicken, fries and a drink."
  }

];

let currentCategory = "All";
let cart = [];

function formatMoney(number){
  return number.toLocaleString("en-NG");
}

function renderProducts(){

  const container = document.getElementById("products");
  const search = document.getElementById("searchInput").value.toLowerCase();

  const filtered = products.filter(product => {

    const categoryMatch =
      currentCategory === "All" ||
      product.category === currentCategory;

    const searchMatch =
      product.name.toLowerCase().includes(search) ||
      product.category.toLowerCase().includes(search);

    return categoryMatch && searchMatch;

  });

  container.innerHTML = filtered.map(product => `

    <article class="card">

      <div
        class="card-img"
        style="background-image:url('${product.image}')">
      </div>

      <div class="card-body">

        <h3>${product.name}</h3>

        <p>${product.description}</p>

        <div class="price-row">

          <span class="price">
            ₦${formatMoney(product.price)}
          </span>

          <button
            class="add-btn"
            onclick="addToCart(${product.id})">
            +
          </button>

        </div>

      </div>

    </article>

  `).join("");

}

function setCategory(category,button){

  currentCategory = category;

  document.querySelectorAll(".category")
    .forEach(btn => btn.classList.remove("active"));

  button.classList.add("active");

  renderProducts();

}

function addToCart(id){

  const product = products.find(p => p.id === id);

  const existing = cart.find(item => item.id === id);

  if(existing){
    existing.quantity++;
  }else{
    cart.push({
      ...product,
      quantity:1
    });
  }

  updateCart();

}

function removeFromCart(id){

  cart = cart.filter(item => item.id !== id);

  updateCart();

}

function updateCart(){

  const count =
    cart.reduce((total,item) => total + item.quantity,0);

  const total =
    cart.reduce(
      (sum,item) => sum + item.price * item.quantity,
      0
    );

  document.getElementById("cartCount").textContent = count;

  document.getElementById("cartTotal").textContent =
    formatMoney(total);

  const cartItems = document.getElementById("cartItems");

  if(cart.length === 0){

    cartItems.innerHTML =
      "<p>Your cart is empty.</p>";

    return;

  }

  cartItems.innerHTML = cart.map(item => `

    <div class="cart-item">

      <div>
        <strong>${item.name}</strong><br>
        <small>
          ${item.quantity} × ₦${formatMoney(item.price)}
        </small>
      </div>

      <button
        class="remove"
        onclick="removeFromCart(${item.id})">
        Remove
      </button>

    </div>

  `).join("");

}

function openCart(){

  document
    .getElementById("cartOverlay")
    .classList.add("show");

}

function closeCart(){

  document
    .getElementById("cartOverlay")
    .classList.remove("show");

}

function scrollToMenu(){

  document
    .getElementById("menu")
    .scrollIntoView();

}

function toggleMenu(){

  document
    .getElementById("navLinks")
    .classList.toggle("show");

}

function openWhatsApp(){

  const phone = "2348000000000";

  const message =
    "Hello CraveHub, I would like to make an order.";

  window.open(
    "https://wa.me/" +
    phone +
    "?text=" +
    encodeURIComponent(message),
    "_blank"
  );

}

function checkout(){

  if(cart.length === 0){

    alert("Your cart is empty.");

    return;

  }

  let message =
    "Hello CraveHub! I want to order:%0A%0A";

  cart.forEach(item => {

    message +=
      "• " +
      item.name +
      " x" +
      item.quantity +
      " - ₦" +
      formatMoney(item.price * item.quantity) +
      "%0A";

  });

  const total =
    cart.reduce(
      (sum,item) =>
      sum + item.price * item.quantity,
      0
    );

  message +=
    "%0ATotal: ₦" +
    formatMoney(total);

  const phone = "2348000000000";

  window.open(
    "https://wa.me/" +
    phone +
    "?text=" +
    message,
    "_blank"
  );

}

renderProducts();
updateCart();

</script>

</body>
</html>
